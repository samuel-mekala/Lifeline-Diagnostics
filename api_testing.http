###
# 1. Create Invoice (PASS)
# Expected: 201 Created, status = DRAFT

POST {{baseUrl}}/api/billing/create/VIS000003/
Authorization: Bearer {{token}}
Content-Type: application/json

###

# 2. Add Test (PASS)
# Expected: 200 OK, subtotal = 300.00

POST {{baseUrl}}/api/billing/add-test/INV000003/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "test_id": "TES0001"
}

###

# 3. Attempt Payment While Invoice is DRAFT (Should Fail)
# Expected: 400 Bad Request

POST {{baseUrl}}/api/billing/record-payment/INV000002/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": "100.00",
    "payment_method": "CASH"
}

###

# 4. Finalize Invoice (PASS)
# Expected: 200 OK
# Status should become UNPAID

POST {{baseUrl}}/api/billing/finalize/INV000002/
Authorization: Bearer {{token}}
Content-Type: application/json

###

# 5. Partial Payment (PASS)
# Expected:
# amount_paid = 150.00
# balance_due = 150.00
# status remains UNPAID

POST {{baseUrl}}/api/billing/record-payment/INV000002/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": "100.00",
    "payment_method": "CASH"
}

###

# 6. Final Payment (PASS)
# Expected:
# amount_paid = 300.00
# balance_due = 0.00
# status = PAID

POST {{baseUrl}}/api/billing/record-payment/INV000002/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": "200.00",
    "payment_method": "CASH"
}

###

# 7. Extra Payment After Invoice is PAID (Should Fail)
# Expected: 400 Bad Request

POST {{baseUrl}}/api/billing/record-payment/INV000002/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": "50.00",
    "payment_method": "CASH"
}

###

# 8. Zero Payment (Should Fail)
# Expected: 400 Bad Request

POST {{baseUrl}}/api/billing/record-payment/INV000002/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": "0.00",
    "payment_method": "CASH"
}

###

# 9. Negative Payment (Should Fail)
# Expected: 400 Bad Request

POST {{baseUrl}}/api/billing/record-payment/INV000002/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": "-100.00",
    "payment_method": "CASH"
}

###

# 10. Invalid Invoice (Should Fail)
# Expected: 404 or 400

POST {{baseUrl}}/api/billing/record-payment/INV999999/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": "100.00",
    "payment_method": "CASH"
}

###

# 11. Apply Valid Discount (PASS)
# Expected:
# discount = 25.00
# total_amount updated
#
# NOTE:
# Run this on a NEW invoice (INV000002), because
# INV000001 is already finalized/paid.

PATCH {{baseUrl}}/api/billing/apply-discount/INV000003/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "discount": "50.00"
}

###

# 12. Excessive Discount (Should Fail)
# Expected: 400 Bad Request
#
# Run on NEW invoice (INV000002)

PATCH {{baseUrl}}/api/billing/apply-discount/INV000003/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "discount": "500.00"
}

###

# 13. Add Test to PAID Invoice (Should Fail)
# Expected: 400 Bad Request

POST {{baseUrl}}/api/billing/add-test/INV000002/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "test_id": "TES0001"
}

###

# 14. Apply Discount to PAID Invoice (Should Fail)
# Expected: 400 Bad Request

POST {{baseUrl}}/api/billing/refund-payment/PAY000003/
