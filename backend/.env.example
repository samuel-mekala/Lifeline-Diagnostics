# Django
SECRET_KEY=replace-with-a-unique-production-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite is the development default)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Production databases: django.db.backends.postgresql or django.db.backends.mysql
# The supplied backend image includes PostgreSQL and MySQL DBAPI drivers.

# Cross-origin requests from the separately deployed frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Production security
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Logging
DJANGO_LOG_LEVEL=INFO
LIFELINE_LOG_LEVEL=INFO

# SMTP email and notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
NOTIFICATION_EMAIL_ENABLED=True
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Optional OpenAI report explanation service
AI_ENABLED=False
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20

# OTP abuse protection
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_REQUEST_THROTTLE=5/hour
OTP_EMAIL_THROTTLE=3/hour
